#!/usr/bin/env bash
# Install the canonical bundled skills for both Claude Code and Codex.
# Idempotent: skips a skill that already exists unless you pass --force.
set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
SRC="$ROOT/agentic-dev-os/skills"
DESTINATIONS=("$HOME/.claude/skills" "$HOME/.agents/skills")

[[ -d "$SRC" ]] || { echo "setup-os: no bundled skills at $SRC" >&2; exit 1; }
FORCE=""
ORCHESTRATOR_ONLY=""
for arg in "$@"; do
  [[ "$arg" == "--force" ]] && FORCE=1
  [[ "$arg" == "--orchestrator" ]] && ORCHESTRATOR_ONLY=1
done

for DEST in "${DESTINATIONS[@]}"; do
  mkdir -p "$DEST"
  echo "==> $DEST"
  for d in "$SRC"/*/; do
    name="$(basename "$d")"
    if [[ -n "$ORCHESTRATOR_ONLY" && "$name" != clide-* ]]; then continue; fi
    if [[ -e "$DEST/$name" && -z "$FORCE" ]]; then
      echo "skip  $name (exists — use --force to overwrite)"
      continue
    fi
    if [[ -e "$DEST/$name" ]]; then rm -rf "$DEST/$name"; fi
    cp -R "$d" "$DEST/$name"
    echo "ok    $name"
  done
done

echo "Done. Restart Claude Code or Codex to load the skills."
