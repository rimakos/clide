#!/usr/bin/env node
const { execFileSync } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

function command(name) {
  try { return execFileSync('/usr/bin/which', [name], { encoding: 'utf8' }).trim(); }
  catch { return null; }
}

const report = {
  platform: `${process.platform} ${process.arch}`,
  node: process.version,
  git: command('git'),
  claude: command('claude'),
  codex: command('codex'),
  nodePty: (() => { try { require('node-pty'); return 'ready'; } catch (error) { return error.message; } })(),
  claudeSkills: fs.existsSync(path.join(os.homedir(), '.claude', 'skills')),
  codexSkills: fs.existsSync(path.join(os.homedir(), '.agents', 'skills')),
  screen: fs.existsSync('/usr/bin/screen'),
  stateFile: path.join(os.homedir(), '.clide', 'state.db')
};
console.log(JSON.stringify(report, null, 2));
process.exitCode = report.git && (report.claude || report.codex) && report.nodePty === 'ready' ? 0 : 1;
