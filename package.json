{
  "name": "clide",
  "version": "0.2.0",
  "description": "Claude and Codex terminal IDE with per-session shells and typed file viewers",
  "author": "Clide contributors",
  "productName": "Clide",
  "repository": "https://github.com/rimakos/clide",
  "engines": {
    "node": ">=22.12"
  },
  "main": "main.js",
  "bin": {
    "clide": "bin/clide"
  },
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "setup-os": "bin/setup-os",
    "test": "node --test",
    "check": "node --check main.js && node --check preload.js && node --check renderer/renderer.js && node --test",
    "test:ui": "node scripts/ui-smoke.js",
    "test:worktree-ui": "node scripts/worktree-smoke.js",
    "test:supervisor": "node scripts/supervisor-smoke.js",
    "test:e2e-five": "node scripts/e2e-five-worktrees.js",
    "test:e2e-orchestrator": "node scripts/e2e-orchestrator.js",
    "doctor": "node bin/doctor",
    "package": "rm -rf dist && npm run package:mac",
    "package:mac": "electron-builder --mac --dir",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "release:mac": "electron-builder --mac --x64 --arm64 --publish always"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.perparim.clide",
    "productName": "Clide",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/build/Release/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**",
      "bin/**",
      "shim/**",
      "agentic-dev-os/**",
      "node_modules/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "sign": false
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
