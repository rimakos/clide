{
  "name": "clide",
  "version": "0.1.0",
  "description": "Claude terminal IDE — typed side-panel viewers for files Claude opens",
  "main": "main.js",
  "bin": {
    "clide": "bin/clide"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/git-status.test.js && node test/diff-parse.test.js && node test/git-graph.test.js && node test/git-commands.test.js",
    "rebuild": "electron-rebuild -f -w node-pty",
    "setup-os": "bin/setup-os",
    "package": "rm -rf dist && electron-packager . Clide --platform=darwin --arch=arm64 --icon=build/icon --asar=false --out=dist --overwrite --app-bundle-id=com.perparim.clide"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "@electron/rebuild": "^3.6.0",
    "electron": "^32.2.0"
  }
}
